// ============================================================================
// PROPOSED PRISMA SCHEMA FOR ARCHITECTURAL REVIEW (NOT EXECUTED)
// A2Z DIAGNOSTICS ENTERPRISE PLATFORM - POSTGRESQL 16 SCHEMA HARMONIZATION
// 
// Description: Harmonized schema where all primary key and foreign key UUID 
//              columns are converted to @db.VarChar(100) to natively support 
//              the application's semantic string IDs:
//                - Users: 'u-admin-01', 'u-cust-01', etc.
//                - Products: 'prod-001', 'prod-002', etc.
//                - Companies: 'comp-roche', 'comp-abbott', etc.
//                - Tickets: 'st-101', 'st-102', etc.
//                - Orders: 'ORD-2026-8842', etc.
//
// SAFETY STATUS: PROPOSAL ONLY. DO NOT RUN prisma db push OR migrate dev/deploy.
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRoleType {
  CUSTOMER
  DISTRIBUTOR
  OFFICE_ADMIN
  OFFICE_STAFF
  SALES_PERSON
  MARKETING_STAFF
  SERVICE_ENGINEER
  SERVICE_MANAGER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CustomerType {
  HOSPITAL_LAB
  INDEPENDENT_DIAGNOSTIC_CENTER
  CLINICAL_LABORATORY
  RESEARCH_INSTITUTE
  BLOOD_BANK
  INDIVIDUAL_PRACTITIONER
}

enum ProductType {
  EQUIPMENT
  REAGENT
  RAPID_KIT
  PLASTIC_CONSUMABLE
  MICROBIOLOGY
  FINE_CHEMICAL
  BLOOD_COLLECTION_TUBE
  URINE_STRIP
  CONTROL_CALIBRATOR
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  ON_HOLD
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  OVERDUE
  FAILED
  REFUNDED
}

enum ServiceTicketCategory {
  EQUIPMENT_BREAKDOWN
  CALIBRATION_REQUEST
  PREVENTIVE_MAINTENANCE
  APPLICATION_SUPPORT
  REAGENT_ISSUE
  SOFTWARE_ERROR
  GENERAL_INQUIRY
}

enum ServiceTicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ServiceTicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING_SPARE_PARTS
  RESOLVED
  CLOSED
  CANCELLED
}

enum ServiceSlaStatus {
  ON_TRACK
  WARNING
  BREACHED
}

enum ServiceCheckStatus {
  PASS
  NEEDS_ATTENTION
  FAIL
}

enum ServiceNoteType {
  INTERNAL
  PUBLIC
}

enum ServiceAttachmentType {
  IMAGE
  DOCUMENT
  LOG_FILE
}

enum ServiceTicketDisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  REJECTED
}

enum CustomerEquipmentStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DECOMMISSIONED
  INACTIVE
}

enum SparePartCriticality {
  CRITICAL
  STANDARD
  LOW
}

enum SparePartStockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ServiceRatingValue {
  ONE_STAR
  TWO_STAR
  THREE_STAR
  FOUR_STAR
  FIVE_STAR
}

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum MaintenanceRecordStatus {
  SCHEDULED
  OVERDUE
  IN_PROGRESS
  COMPLETED
}

enum RepeatProblemStatus {
  NEW
  UNDER_REVIEW
  ESC_MANUFACTURER
  REPLACEMENT_RECOMMENDED
  RESOLVED
  CLOSED
}

// ----------------------------------------------------------------------------
// PHASE 1: AUTHENTICATION, ROLES, PERMISSIONS & USERS
// ----------------------------------------------------------------------------

model User {
  id                String       @id @db.VarChar(100)
  username          String?      @unique @db.VarChar(100)
  email             String       @unique @db.VarChar(255)
  phoneNumber       String       @unique @db.VarChar(30)
  passwordHash      String       @db.VarChar(255)
  firstName         String       @db.VarChar(100)
  lastName          String       @db.VarChar(100)
  avatarUrl         String?      @db.VarChar(500)
  roleType          UserRoleType @default(CUSTOMER)
  status            UserStatus   @default(ACTIVE)
  dataScope         String       @default("OWN") @db.VarChar(50)
  branch            String?      @db.VarChar(100)
  region            String?      @db.VarChar(50)
  isEmailVerified   Boolean      @default(false)
  isPhoneVerified   Boolean      @default(false)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String?      @db.VarChar(255)
  lastLoginAt       DateTime?
  lastLoginIp       String?      @db.VarChar(45)
  failedLoginAttempts Int        @default(0)
  lockoutUntil      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  // Relations
  roles                 UserRoleMapping[]
  sessions              UserSession[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  customerProfile       CustomerProfile?
  employeeProfile       EmployeeProfile?
  customerEquipments    CustomerEquipment[]
  customerAddresses     CustomerAddress[]
  customerTickets       ServiceTicket[]                 @relation("CustomerTickets")
  engineerTickets       ServiceTicket[]                 @relation("EngineerTickets")
  serviceNotes          ServiceTicketNote[]
  serviceAttachments    ServiceTicketAttachment[]
  serviceReviews        ServiceTicketBackOfficeReview[]

  @@index([email])
  @@index([phoneNumber])
  @@index([roleType])
  @@index([status])
  @@map("users")
}

model Role {
  id          String            @id @db.VarChar(100)
  name        String            @unique @db.VarChar(100)
  description String?           @db.VarChar(255)
  isSystem    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  users       UserRoleMapping[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @db.VarChar(100)
  name        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(100)
  action      String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRoleMapping {
  id         String    @id @db.VarChar(100)
  userId     String    @db.VarChar(100)
  roleId     String    @db.VarChar(100)
  assignedAt DateTime  @default(now())
  assignedBy String?   @db.VarChar(100)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @db.VarChar(100)
  roleId       String     @db.VarChar(100)
  permissionId String     @db.VarChar(100)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id           String    @id @db.VarChar(100)
  userId       String    @db.VarChar(100)
  token        String    @unique @db.VarChar(500)
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.Text
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model RefreshToken {
  id          String    @id @db.VarChar(100)
  userId      String    @db.VarChar(100)
  tokenHash   String    @unique @db.VarChar(255)
  family      String    @db.VarChar(100)
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String    @id @db.VarChar(100)
  userId      String?   @db.VarChar(100)
  action      String    @db.VarChar(100)
  entityType  String    @db.VarChar(100)
  entityId    String?   @db.VarChar(100)
  oldValues   Json?
  newValues   Json?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// CUSTOMER & EMPLOYEE PROFILES
// ----------------------------------------------------------------------------

model CustomerProfile {
  id                 String       @id @db.VarChar(100)
  userId             String       @unique @db.VarChar(100)
  customerCode       String?      @unique @db.VarChar(100)
  labName            String       @db.VarChar(255)
  legalName          String?      @db.VarChar(255)
  customerType       CustomerType @default(CLINICAL_LABORATORY)
  gstNumber          String?      @db.VarChar(30)
  panNumber          String?      @db.VarChar(20)
  drugLicenseNumber  String?      @db.VarChar(100)
  contactPerson      String       @db.VarChar(100)
  contactEmail       String       @db.VarChar(255)
  contactPhone       String       @db.VarChar(30)
  addressLine1       String       @db.VarChar(255)
  addressLine2       String?      @db.VarChar(255)
  city               String       @db.VarChar(100)
  state              String       @db.VarChar(100)
  pincode            String       @db.VarChar(20)
  creditLimit        Decimal      @default(0.00) @db.Decimal(12, 2)
  creditPeriodDays   Int          @default(30)
  currentOutstanding Decimal      @default(0.00) @db.Decimal(12, 2)
  isApproved         Boolean      @default(false)
  approvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_profiles")
}

model EmployeeProfile {
  id                 String       @id @db.VarChar(100)
  userId             String       @unique @db.VarChar(100)
  employeeCode       String       @unique @db.VarChar(50)
  designation        String       @db.VarChar(100)
  department         String       @db.VarChar(100)
  reportingManagerId String?      @db.VarChar(100)
  assignedTerritory  String?      @db.VarChar(100)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("employee_profiles")
}

// ----------------------------------------------------------------------------
// PHASE 2: CATALOG, PRODUCTS, COMPANIES & CATEGORIES
// ----------------------------------------------------------------------------

model Company {
  id           String    @id @db.VarChar(100)
  code         String    @unique @db.VarChar(50)
  name         String    @db.VarChar(150)
  legalName    String?   @db.VarChar(255)
  logoUrl      String?   @db.VarChar(500)
  website      String?   @db.VarChar(255)
  country      String    @default("India") @db.VarChar(100)
  description  String?   @db.Text
  contactEmail String?   @db.VarChar(255)
  contactPhone String?   @db.VarChar(50)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]

  @@index([code])
  @@map("companies")
}

model Category {
  id               String     @id @db.VarChar(100)
  code             String     @unique @db.VarChar(50)
  name             String     @db.VarChar(150)
  slug             String     @unique @db.VarChar(150)
  description      String?    @db.Text
  icon             String?    @db.VarChar(100)
  imageUrl         String?    @db.VarChar(500)
  parentId         String?    @db.VarChar(100)
  sortOrder        Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  childCategories  Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id                         String              @id @db.VarChar(100)
  sku                        String              @unique @db.VarChar(100)
  catalogNumber              String?             @db.VarChar(100)
  name                       String              @db.VarChar(255)
  shortDescription           String?             @db.VarChar(500)
  description                String?             @db.Text
  companyId                  String              @db.VarChar(100)
  categoryId                 String              @db.VarChar(100)
  productType                ProductType         @default(REAGENT)
  hsnCode                    String              @default("38220090") @db.VarChar(20)
  gstRate                    Decimal             @default(12.00) @db.Decimal(5, 2)
  basePrice                  Decimal             @db.Decimal(12, 2)
  mrp                        Decimal             @db.Decimal(12, 2)
  minOrderQuantity           Int                 @default(1)
  isColdChain                Boolean             @default(false)
  storageTemperature         String?             @db.VarChar(50)
  shelfLifeMonths            Int?
  requiresPrescriptionOrAuth Boolean             @default(false)
  isActive                   Boolean             @default(true)
  isFeatured                 Boolean             @default(false)
  isDiscontinued             Boolean             @default(false)
  packSize                   String              @db.VarChar(100)
  stockQuantity              Int                 @default(0)
  stockStatus                String              @default("IN_STOCK") @db.VarChar(50)
  leadTimeDays               Int                 @default(2)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  company                    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category                   Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                     ProductImage[]
  documents                  ProductDocument[]
  packOptions                ProductPackOption[]

  @@index([sku])
  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @db.VarChar(100)
  productId String   @db.VarChar(100)
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(255)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id           String   @id @db.VarChar(100)
  productId    String   @db.VarChar(100)
  title        String   @db.VarChar(255)
  documentType String   @db.VarChar(50)
  fileUrl      String   @db.VarChar(500)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

model ProductPackOption {
  id                 String   @id @db.VarChar(100)
  productId          String   @db.VarChar(100)
  packSizeName       String   @db.VarChar(100)
  quantityMultiplier Int      @default(1)
  price              Decimal  @db.Decimal(12, 2)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_pack_options")
}

// ----------------------------------------------------------------------------
// PHASE 2.5: CUSTOMER EQUIPMENT & BIOMEDICAL SERVICE TICKETS
// ----------------------------------------------------------------------------

model CustomerEquipment {
  id                 String    @id @db.VarChar(100)
  customerId         String    @db.VarChar(100)
  customerLabName    String?   @db.VarChar(255)
  customerCode       String?   @db.VarChar(100)
  productId          String?   @db.VarChar(100)
  productSku         String?   @db.VarChar(100)
  equipmentName      String    @db.VarChar(255)
  companyId          String?   @db.VarChar(100)
  companyName        String?   @db.VarChar(150)
  modelNumber        String    @db.VarChar(100)
  serialNumber       String    @unique @db.VarChar(100)
  manufacturer       String?   @db.VarChar(100)
  department         String?   @db.VarChar(100)
  locationDepartment String?   @db.VarChar(100)
  contactPerson      String?   @db.VarChar(100)
  contactPhone       String?   @db.VarChar(30)
  installationDate   DateTime?
  warrantyStatus     String?   @db.VarChar(50)
  warrantyExpiryDate DateTime?
  lastServiceDate    DateTime?
  nextPmDueDate      DateTime?
  status             String    @default("ACTIVE") @db.VarChar(50)
  healthScore        Int?
  qrCode             String?   @db.VarChar(255)
  imageUrl           String?   @db.VarChar(500)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer       User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceTickets ServiceTicket[]

  @@index([customerId])
  @@index([serialNumber])
  @@map("customer_equipments")
}

model ServiceSparePartCatalog {
  id          String               @id @db.VarChar(100)
  partNumber  String               @unique @db.VarChar(100)
  partName    String               @db.VarChar(255)
  costPrice   Decimal              @db.Decimal(12, 2)
  salePrice   Decimal              @db.Decimal(12, 2)
  stockQty    Int                  @default(0)
  criticality SparePartCriticality @default(STANDARD)
  stockStatus SparePartStockStatus @default(IN_STOCK)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  partsUsed   ServiceTicketPartUsed[]

  @@map("service_spare_parts_catalog")
}

model ServiceTicket {
  id                 String                @id @db.VarChar(100)
  ticketNumber       String                @unique @db.VarChar(100)
  customerId         String                @db.VarChar(100)
  category           ServiceTicketCategory @default(EQUIPMENT_BREAKDOWN)
  equipmentId        String?               @db.VarChar(100)
  priority           ServiceTicketPriority @default(HIGH)
  title              String                @db.VarChar(255)
  description        String                @db.Text
  errorCode          String?               @db.VarChar(100)
  status             ServiceTicketStatus   @default(NEW)
  assignedEngineerId String?               @db.VarChar(100)
  slaTargetHours     Int                   @default(8)
  slaTargetTimestamp DateTime
  slaStatus          ServiceSlaStatus      @default(ON_TRACK)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  customer           User                  @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignedEngineer   User?                 @relation("EngineerTickets", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  equipment          CustomerEquipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  checkIn            ServiceTicketCheckIn?
  checkOut           ServiceTicketCheckOut?
  notes              ServiceTicketNote[]
  attachments        ServiceTicketAttachment[]
  partsUsed          ServiceTicketPartUsed[]
  resolution         ServiceTicketResolution?
  communications     ServiceTicketCommunication[]
  feedback           ServiceTicketFeedback?
  review             ServiceTicketBackOfficeReview?
  dispute            ServiceTicketDispute?

  @@index([customerId])
  @@index([assignedEngineerId])
  @@index([ticketNumber])
  @@map("service_tickets")
}

model ServiceTicketCheckIn {
  id         String        @id @db.VarChar(100)
  ticketId   String        @unique @db.VarChar(100)
  latitude   Decimal?      @db.Decimal(10, 7)
  longitude  Decimal?      @db.Decimal(10, 7)
  checkInAt  DateTime      @default(now())
  batteryPct Int?

  ticket     ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("service_ticket_check_ins")
}

model ServiceTicketCheckOut {
  id         String        @id @db.VarChar(100)
  ticketId   String        @unique @db.VarChar(100)
  checkOutAt DateTime      @default(now())

  ticket     ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("service_ticket_check_outs")
}

model ServiceTicketNote {
  id         String          @id @db.VarChar(100)
  ticketId   String          @db.VarChar(100)
  authorId   String          @db.VarChar(100)
  noteType   ServiceNoteType @default(INTERNAL)
  content    String          @db.Text
  createdAt  DateTime        @default(now())

  ticket     ServiceTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("service_ticket_notes")
}

model ServiceTicketAttachment {
  id             String                @id @db.VarChar(100)
  ticketId       String                @db.VarChar(100)
  fileName       String                @db.VarChar(255)
  fileUrl        String                @db.Text
  fileSizeBytes  Int?
  mimeType       String                @db.VarChar(100)
  attachmentType ServiceAttachmentType
  uploadedById   String                @db.VarChar(100)
  uploadedAt     DateTime              @default(now())

  ticket         ServiceTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy     User                  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("service_ticket_attachments")
}

model ServiceTicketPartUsed {
  id                String                   @id @db.VarChar(100)
  ticketId          String                   @db.VarChar(100)
  partCatalogId     String?                  @db.VarChar(100)
  partName          String                   @db.VarChar(255)
  quantity          Int                      @default(1)
  unitPrice         Decimal                  @db.Decimal(12, 2)
  isUnderWarranty   Boolean                  @default(false)
  usedAt            DateTime                 @default(now())

  ticket            ServiceTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  partCatalog       ServiceSparePartCatalog? @relation(fields: [partCatalogId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("service_ticket_parts_used")
}

model ServiceTicketResolution {
  id             String        @id @db.VarChar(100)
  ticketId       String        @unique @db.VarChar(100)
  rootCause      String        @db.Text
  actionTaken    String        @db.Text
  preventiveAdvice String?     @db.Text
  resolvedAt     DateTime      @default(now())

  ticket         ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("service_ticket_resolutions")
}

model ServiceTicketCommunication {
  id         String        @id @db.VarChar(100)
  ticketId   String        @db.VarChar(100)
  senderType String        @db.VarChar(50)
  message    String        @db.Text
  sentAt     DateTime      @default(now())

  ticket     ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("service_ticket_communications")
}

model ServiceTicketFeedback {
  id              String             @id @db.VarChar(100)
  ticketId        String             @unique @db.VarChar(100)
  overallRating   ServiceRatingValue @default(FIVE_STAR)
  feedbackComment String?            @db.Text
  submittedAt     DateTime           @default(now())

  ticket          ServiceTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("service_ticket_feedbacks")
}

model ServiceTicketBackOfficeReview {
  id           String        @id @db.VarChar(100)
  ticketId     String        @unique @db.VarChar(100)
  reviewedById String        @db.VarChar(100)
  reviewNotes  String?       @db.Text
  isBillable   Boolean       @default(false)
  laborCharges Decimal       @default(0.00) @db.Decimal(12, 2)
  partsCharges Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  reviewedAt   DateTime      @default(now())

  ticket       ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reviewedBy   User          @relation(fields: [reviewedById], references: [id], onDelete: Cascade)

  @@map("service_ticket_back_office_reviews")
}

model ServiceTicketDispute {
  id            String                     @id @db.VarChar(100)
  ticketId      String                     @unique @db.VarChar(100)
  disputeReason String                     @db.Text
  status        ServiceTicketDisputeStatus @default(OPEN)
  raisedAt      DateTime                   @default(now())
  resolvedAt    DateTime?

  ticket        ServiceTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("service_ticket_disputes")
}

// ----------------------------------------------------------------------------
// PHASE 3: COMMERCE, CREDIT & PERSISTENCE MODELS
// ----------------------------------------------------------------------------

model CustomerOrder {
  id                  String    @id @db.VarChar(100)
  orderNumber         String    @unique @db.VarChar(100)
  customerId          String    @db.VarChar(100)
  customerLabName     String    @db.VarChar(255)
  items               Json      // Array of order items
  itemCount           Int       @default(0)
  subtotal            Decimal   @db.Decimal(12, 2)
  gstAmount           Decimal   @db.Decimal(12, 2)
  coldChainFee        Decimal   @db.Decimal(12, 2)
  grandTotal          Decimal   @db.Decimal(12, 2)
  status              String    @db.VarChar(50)
  paymentStatus       String    @db.VarChar(50)
  paymentMethod       String?   @db.VarChar(50)
  coldChainMonitoring Json?
  shippingAddress     String    @db.Text
  deliveryDate        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@map("customer_orders")
}

model CustomerCreditProfile {
  id                        String    @id @db.VarChar(100)
  customerId                String    @unique @db.VarChar(100)
  customerLabName           String    @db.VarChar(255)
  creditLimit               Decimal   @db.Decimal(12, 2)
  availableCredit           Decimal   @db.Decimal(12, 2)
  currentOutstanding        Decimal   @db.Decimal(12, 2)
  creditPeriodDays          Int       @default(30)
  dueDate                   DateTime?
  daysOverdue               Int       @default(0)
  paymentStatus             String    @db.VarChar(50)
  hasApprovedExtension      Boolean   @default(false)
  approvedExtensionUntil    DateTime?
  walletPoints              Int       @default(0)
  businessRating            Decimal   @db.Decimal(3, 2)
  paymentReliabilityPercent Decimal   @db.Decimal(5, 2)
  paymentHistory            Json      // Array of payment history records
  paymentPromises           Json      // Array of payment promises
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([customerId])
  @@map("customer_credit_profiles")
}

model PaymentExtensionRequest {
  id                        String    @id @db.VarChar(100)
  customerId                String    @db.VarChar(100)
  customerLabName           String    @db.VarChar(255)
  customerContactName       String    @db.VarChar(100)
  customerEmail             String    @db.VarChar(255)
  companyName               String    @db.VarChar(255)
  siteName                  String    @db.VarChar(255)
  invoiceNumber             String    @db.VarChar(100)
  orderNumber               String    @db.VarChar(100)
  outstandingAmount         Decimal   @db.Decimal(12, 2)
  originalDueDate           DateTime
  requestedDays             Int
  reason                    String    @db.VarChar(255)
  explanation               String    @db.Text
  promisedPaymentDate       DateTime
  status                    String    @default("PENDING") @db.VarChar(50)
  approvedDays              Int?
  approvedUntil             DateTime?
  internalNotes             String?   @db.Text
  reviewedBy                String?   @db.VarChar(100)
  reviewedAt                DateTime?
  previousExtensionsCount   Int       @default(0)
  previousLatePaymentsCount Int       @default(0)
  businessRating            Decimal   @default(5.0) @db.Decimal(3, 2)
  walletPoints              Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("payment_extension_requests")
}

model CustomerTestimonial {
  id                 String    @id @db.VarChar(100)
  customerName       String    @db.VarChar(150)
  companyName        String    @db.VarChar(150)
  laboratory         String    @db.VarChar(150)
  testimonial        String    @db.Text
  rating             Int       @default(5)
  isActive           Boolean   @default(true)
  displayOrder       Int       @default(0)
  assignedCustomerId String?   @db.VarChar(100)
  avatarUrl          String?   @db.VarChar(500)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive])
  @@map("customer_testimonials")
}

model RelatedProductMapping {
  id                    String   @id @db.VarChar(100)
  primaryProductId      String   @db.VarChar(100)
  analyte               String   @db.VarChar(150)
  company               String   @db.VarChar(150)
  productName           String   @db.VarChar(255)
  packSize              String   @db.VarChar(100)
  price                 Decimal  @db.Decimal(12, 2)
  availability          String   @db.VarChar(50)
  analyzerCompatibility Json     // Array of analyzer strings
  specifications        Json     // Key-value specifications
  isColdChain           Boolean  @default(false)
  sortOrder             Int      @default(0)

  @@index([primaryProductId])
  @@map("related_product_mappings")
}

model ServiceSlaPolicy {
  id                    String   @id @db.VarChar(100)
  criticalResponseHours Int      @default(2)
  highResponseHours     Int      @default(4)
  mediumResponseHours   Int      @default(8)
  lowResponseHours      Int      @default(24)
  serviceTierName       String   @db.VarChar(100)
  dispatchDescription   String   @db.Text
  disclaimer            String   @db.Text
  updatedAt             DateTime @updatedAt

  @@map("service_sla_policies")
}

model LatePaymentPenaltyPolicy {
  id                 String   @id @db.VarChar(100)
  gracePeriodDays    Int      @default(7)
  interestRateAnnual Decimal  @default(18.00) @db.Decimal(5, 2)
  lateFeeFlat        Decimal  @default(500.00) @db.Decimal(12, 2)
  warningThreshold1  Int      @default(3)
  warningThreshold2  Int      @default(7)
  freezeAccountDays  Int      @default(15)
  updatedAt          DateTime @updatedAt

  @@map("late_payment_penalty_policies")
}

model CustomerNotificationRecord {
  id             String   @id @db.VarChar(100)
  customerId     String?  @db.VarChar(100)
  title          String   @db.VarChar(255)
  message        String   @db.Text
  type           String   @db.VarChar(50)
  isRead         Boolean  @default(false)
  timestamp      DateTime @default(now())
  actionDeepLink String?  @db.VarChar(255)

  @@index([customerId])
  @@map("customer_notifications")
}

model CustomerWallet {
  id                  String   @id @db.VarChar(100)
  customerId          String   @unique @db.VarChar(100)
  customerLabName     String   @db.VarChar(255)
  creditLimit         Decimal  @db.Decimal(12, 2)
  currentOutstanding  Decimal  @db.Decimal(12, 2)
  availableCredit     Decimal  @db.Decimal(12, 2)
  unbilledOrdersCount Int      @default(0)
  paymentTermsDays    Int      @default(30)
  walletBalance       Decimal  @default(0.00) @db.Decimal(12, 2)
  ledgerEntries       Json     // Array of ledger entry items
  updatedAt           DateTime @updatedAt

  @@index([customerId])
  @@map("customer_wallets")
}

// ----------------------------------------------------------------------------
// PHASE 4: MULTI-ADDRESS & COMMERCIAL RULES ENGINES
// ----------------------------------------------------------------------------

model CustomerAddress {
  id            String   @id @db.VarChar(100)
  customerId    String   @db.VarChar(100)
  label         String   @db.VarChar(150)
  contactPerson String   @db.VarChar(100)
  phoneNumber   String   @db.VarChar(30)
  addressLine1  String   @db.VarChar(255)
  addressLine2  String?  @db.VarChar(255)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @db.VarChar(20)
  gstin         String?  @db.VarChar(30)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model ProductAccessRule {
  id                 String    @id @db.VarChar(100)
  ruleType           String    @db.VarChar(50) // FORCE_HIDE, FORCE_SHOW, EXPLICIT_ACCESS, RESTRICTED
  customerId         String?   @db.VarChar(100)
  customerLabName    String?   @db.VarChar(255)
  productId          String?   @db.VarChar(100)
  productSku         String?   @db.VarChar(100)
  productName        String?   @db.VarChar(255)
  categoryId         String?   @db.VarChar(100)
  companyId          String?   @db.VarChar(100)
  reason             String?   @db.Text
  isActive           Boolean   @default(true)
  effectiveStartDate DateTime?
  effectiveEndDate   DateTime?
  approvalStatus     String    @default("PENDING_APPROVAL") @db.VarChar(50)
  makerId            String    @db.VarChar(100)
  makerEmail         String    @db.VarChar(255)
  checkerId          String?   @db.VarChar(100)
  checkerEmail       String?   @db.VarChar(255)
  approvedAt         DateTime?
  rejectionReason    String?   @db.Text
  priority           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerId])
  @@index([productId])
  @@index([ruleType])
  @@map("product_access_rules")
}

model CustomerPriceRule {
  id                 String    @id @db.VarChar(100)
  customerId         String    @db.VarChar(100)
  customerLabName    String?   @db.VarChar(255)
  ruleTier           String    @db.VarChar(50) // CONTRACT_SKU, CUSTOMER_EQUIPMENT, QUANTITY_SLAB, etc.
  productId          String?   @db.VarChar(100)
  productSku         String?   @db.VarChar(100)
  productName        String?   @db.VarChar(255)
  equipmentId        String?   @db.VarChar(100)
  equipmentName      String?   @db.VarChar(255)
  companyId          String?   @db.VarChar(100)
  companyName        String?   @db.VarChar(150)
  categoryId         String?   @db.VarChar(100)
  categoryName       String?   @db.VarChar(150)
  customFixedPrice   Decimal?  @db.Decimal(12, 2)
  discountPercent    Decimal?  @db.Decimal(5, 2)
  quantitySlabs      Json?     // Array of QuantitySlabEntity
  paymentMethod      String?   @default("ALL") @db.VarChar(50)
  priority           Int       @default(0)
  isActive           Boolean   @default(true)
  effectiveStartDate DateTime?
  effectiveEndDate   DateTime?
  validUntil         DateTime?
  approvalStatus     String    @default("PENDING_APPROVAL") @db.VarChar(50)
  makerId            String    @db.VarChar(100)
  makerEmail         String    @db.VarChar(255)
  checkerId          String?   @db.VarChar(100)
  checkerEmail       String?   @db.VarChar(255)
  approvedAt         DateTime?
  rejectionReason    String?   @db.Text
  pricingVersion     Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerId])
  @@index([productId])
  @@index([ruleTier])
  @@map("customer_price_rules")
}
