  id                     String          @id @db.VarChar(100)
  batchId                String          @map("batch_id") @db.VarChar(100)
  rowNumber              Int             @map("row_number")
  sku                    String          @db.VarChar(100)
  name                   String          @db.VarChar(255)
  companyId              String?         @map("company_id") @db.VarChar(100)
  companyNameOrCode      String?         @map("company_name_or_code") @db.VarChar(255)
  categoryId             String?         @map("category_id") @db.VarChar(100)
  categoryNameOrCode     String?         @map("category_name_or_code") @db.VarChar(255)
  subcategoryId          String?         @map("subcategory_id") @db.VarChar(100)
  subcategoryNameOrCode  String?         @map("subcategory_name_or_code") @db.VarChar(255)
  productType            String          @default("REAGENT") @map("product_type") @db.VarChar(50)
  description            String?         @db.Text
  classification         String?         @db.VarChar(100)
  compatibleEquipment    String?         @map("compatible_equipment") @db.VarChar(255)
  compatibleCompany      String?         @map("compatible_company") @db.VarChar(255)
  testParameter          String?         @map("test_parameter") @db.VarChar(150)
  method                 String?         @db.VarChar(150)
  packSize               String?         @map("pack_size") @db.VarChar(100)
  unit                   String?         @db.VarChar(50)
  testsPerPack           Int?            @map("tests_per_pack")
  storageCondition       String?         @map("storage_condition") @db.VarChar(100)
  isColdChain            Boolean         @default(false) @map("is_cold_chain")
  shelfLifeMonths        Int?            @map("shelf_life_months")
  manufacturerPartNumber String?         @map("manufacturer_part_number") @db.VarChar(100)
  hsnCode                String?         @map("hsn_code") @db.VarChar(50)
  basePrice              Decimal         @default(0.00) @map("base_price") @db.Decimal(12, 2)
  mrp                    Decimal         @default(0.00) @db.Decimal(12, 2)
  gstRate                Decimal         @default(12.00) @map("gst_rate") @db.Decimal(5, 2)
  minOrderQuantity       Int             @default(1) @map("min_order_quantity")
  maxOrderQuantity       Int?            @map("max_order_quantity")
  allowOnlineOrder       Boolean         @default(true) @map("allow_online_order")
  inquiryOnly            Boolean         @default(false) @map("inquiry_only")
  trackInventory         Boolean         @default(true) @map("track_inventory")
  stockQuantity          Int             @default(0) @map("stock_quantity")
  stockStatus            String          @default("IN_STOCK") @map("stock_status") @db.VarChar(50)
  productStatus          String          @default("ACTIVE") @map("product_status") @db.VarChar(50)
  brand                  String?         @db.VarChar(150)
  imageFileName          String?         @map("image_file_name") @db.VarChar(255)
  imageUrl               String?         @map("image_url") @db.Text
  resolvedImageUrl       String?         @map("resolved_image_url") @db.Text
  action                 ImportRowAction @default(CREATE)
  isExisting             Boolean         @default(false) @map("is_existing")
  existingProductId      String?         @map("existing_product_id") @db.VarChar(100)
  isValid                Boolean         @default(true) @map("is_valid")
  validationIssues       Json?           @map("validation_issues")
  importStatus           ImportRowStatus @default(PENDING) @map("import_status")
  errorMessage           String?         @map("error_message") @db.Text
  targetProductId        String?         @map("target_product_id") @db.VarChar(100)
  createdAt              DateTime        @default(now()) @map("created_at")

  batch                  StagingProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, importStatus])
  @@index([sku])
  @@index([companyId])
  @@map("staging_product_rows")
}

model StagingCustomerBatch {
  id                    String             @id @db.VarChar(100)
  batchNumber           String             @unique @map("batch_number") @db.VarChar(100)
  fileName              String             @map("file_name") @db.VarChar(255)
  fileSizeBytes         Int                @default(0) @map("file_size_bytes")
  companyId             String?            @map("company_id") @db.VarChar(100)
  uploadedByUserId      String             @map("uploaded_by_user_id") @db.VarChar(100)
  uploadedByUserName    String             @map("uploaded_by_user_name") @db.VarChar(255)
  uploadedByUserEmail   String             @map("uploaded_by_user_email") @db.VarChar(255)
  uploadedByUserRole    String             @map("uploaded_by_user_role") @db.VarChar(100)
  importMode            String             @default("CREATE_ONLY") @map("import_mode") @db.VarChar(50)
  status                ImportBatchStatus  @default(READY_FOR_REVIEW)
  totalRows             Int                @default(0) @map("total_rows")
  validRows             Int                @default(0) @map("valid_rows")
  errorRows             Int                @default(0) @map("error_rows")
  warningRows           Int                @default(0) @map("warning_rows")
  newCustomersCount     Int                @default(0) @map("new_customers_count")
  updatedCustomersCount Int                @default(0) @map("updated_customers_count")
  skippedRowsCount      Int                @default(0) @map("skipped_rows_count")
  approvedByUserId      String?            @map("approved_by_user_id") @db.VarChar(100)
  approvedByUserName    String?            @map("approved_by_user_name") @db.VarChar(255)
  approvedAt            DateTime?          @map("approved_at")
  approvalNotes         String?            @map("approval_notes") @db.Text
  rejectedByUserId      String?            @map("rejected_by_user_id") @db.VarChar(100)
  rejectedByUserName    String?            @map("rejected_by_user_name") @db.VarChar(255)
  rejectedAt            DateTime?          @map("rejected_at")
  rejectionNotes        String?            @map("rejection_notes") @db.Text
  completedAt           DateTime?          @map("completed_at")
  errorMessage          String?            @map("error_message") @db.Text
  issuesSummary         Json?              @map("issues_summary")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  rows                  StagingCustomerRow[]

  @@index([status])
  @@index([uploadedByUserId])
  @@index([companyId])
  @@index([createdAt])
  @@map("staging_customer_batches")
}

