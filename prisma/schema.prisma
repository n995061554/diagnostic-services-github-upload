// ============================================================================
// A2Z DIAGNOSTICS ENTERPRISE PLATFORM - CANONICAL POSTGRESQL PRISMA SCHEMA
// File: prisma/canonical_schema.prisma
//
// PURPOSE:
// Unified, harmonized target schema reconciling prisma/schema.prisma and
// prisma/proposed_schema.prisma for staging and production PostgreSQL readiness.
//
// DESIGN PRINCIPLES:
// 1. String-Compatible Semantic IDs:
//    All primary keys and foreign keys use VARCHAR(100) / String to natively
//    support the platform's established semantic identifiers (e.g., 'u-admin-01',
//    'prod-001', 'comp-roche', 'ORD-2026-8842', 'st-101', 'eq-c311-01').
// 2. Complete Runtime Field Preservation:
//    Preserves AuditLog telemetry fields, ServiceTicket SLA & workflow timestamps,
//    UserSession active-device inspection fields, and ProductPackOption multipliers.
// 3. Grounded Entity Coverage:
//    Includes CustomerAddress, CustomerEquipment (23 fields), ProductAccessRule,
//    and CustomerPriceRule based on verified runtime repositories and routes.
// 4. Strict Safety Compliance:
//    Standalone target artifact. Does NOT alter active schema.prisma or migrations.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRoleType {
  SUPER_ADMIN
  OFFICE_ADMIN
  OFFICE_STAFF
  SALES_MANAGER
  SALES_REP
  SERVICE_ENGINEER
  ACCOUNTANT
  CUSTOMER
  LAB_STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  PENDING_VERIFICATION
  PENDING_ACTIVATION
  SUSPENDED
  DEACTIVATED
}

enum DataScope {
  ALL
  TERRITORY
  REGION
  BRANCH
  OWN
}

enum CustomerType {
  CLINICAL_LABORATORY
  HOSPITAL_LAB
  RESEARCH_INSTITUTE
  BLOOD_BANK
  DIAGNOSTIC_CHAIN
  INDIVIDUAL_PRACTITIONER
}

enum Department {
  EXECUTIVE
  OPERATIONS
  SALES
  SERVICE
  FINANCE
  IT_ADMIN
}

enum ProductType {
  REAGENT
  INSTRUMENT
  CONSUMABLE
  RAPID_TEST
  CALIBRATOR_CONTROL
  EQUIPMENT
  ACCESSORY
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  CALL_FOR_ORDER
  DISCONTINUED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  ASSIGNED
  ACKNOWLEDGED
  SCHEDULED
  ON_THE_WAY
  IN_PROGRESS
  SPARE_PARTS_PENDING
  BACK_OFFICE_REVIEW
  RESOLVED
  CLOSED
  DISPUTED
  REOPENED
  CANCELLED
}

enum SparePartCriticality {
  CRITICAL
  HIGH
  STANDARD
  OPTIONAL
}

enum SparePartStockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_ORDER
}

// ============================================================================
// 1. CORE AUTHENTICATION & RBAC MODELS
// ============================================================================

model User {
  id                  String       @id @db.VarChar(100)
  username            String?      @unique @db.VarChar(100)
  email               String       @unique @db.VarChar(255)
  phoneNumber         String?      @unique @map("phone_number") @db.VarChar(30)
  passwordHash        String       @map("password_hash") @db.VarChar(255)
  firstName           String       @map("first_name") @db.VarChar(100)
  lastName            String       @map("last_name") @db.VarChar(100)
  avatarUrl           String?      @map("avatar_url") @db.VarChar(500)
  roleType            UserRoleType @default(CUSTOMER) @map("role_type")
  status              UserStatus   @default(ACTIVE)
  dataScope           DataScope    @default(OWN) @map("data_scope")
  branch              String?      @db.VarChar(100)
  region              String?      @db.VarChar(100)
  isEmailVerified     Boolean      @default(false) @map("is_email_verified")
  isPhoneVerified     Boolean      @default(false) @map("is_phone_verified")
  twoFactorEnabled    Boolean      @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?      @map("two_factor_secret") @db.VarChar(255)
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?    @map("lockout_until")
  lastLoginAt         DateTime?    @map("last_login_at")
  mustChangePassword  Boolean      @default(false) @map("must_change_password")
  passwordCreatedAt   DateTime     @default(now()) @map("password_created_at")
  activationExpiresAt DateTime?    @map("activation_expires_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relations
  roles               UserRole[]
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  customerProfile     CustomerProfile?
  employeeProfile     EmployeeProfile?
  customerEquipments  CustomerEquipment[]
  customerAddresses   CustomerAddress[]
  customerTickets     ServiceTicket[]             @relation("CustomerTickets")
  assignedTickets     ServiceTicket[]             @relation("AssignedEngineerTickets")
  customerWallet      CustomerWallet?
  customerOrders      CustomerOrder[]

  @@index([email])
  @@index([phoneNumber])
  @@index([roleType])
  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @db.VarChar(100)
  name        String           @unique @db.VarChar(50)
  displayName String?          @map("display_name") @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @db.VarChar(100)
  code        String           @unique @db.VarChar(100)
  name        String?          @db.VarChar(100)
  description String?          @db.Text
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @db.VarChar(100)
  userId     String   @map("user_id") @db.VarChar(100)
  roleId     String   @map("role_id") @db.VarChar(100)
  assignedAt DateTime @default(now()) @map("assigned_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @db.VarChar(100)
  roleId       String     @map("role_id") @db.VarChar(100)
  permissionId String     @map("permission_id") @db.VarChar(100)
  grantedAt    DateTime   @default(now()) @map("granted_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id             String   @id @db.VarChar(100)
  userId         String   @map("user_id") @db.VarChar(100)
  tokenHash      String?  @map("token_hash") @db.VarChar(255)
  sessionToken   String?  @map("session_token") @db.VarChar(255)
  deviceType     String?  @map("device_type") @db.VarChar(50)
  deviceName     String?  @map("device_name") @db.VarChar(100)
  browser        String?  @db.VarChar(100)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  approxLocation String?  @map("approx_location") @db.VarChar(200)
  isActive       Boolean  @default(true) @map("is_active")
  isCurrent      Boolean  @default(true) @map("is_current")
  isRevoked      Boolean  @default(false) @map("is_revoked")
  loginAt        DateTime @default(now()) @map("login_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model RefreshToken {
  id        String   @id @db.VarChar(100)
  userId    String   @map("user_id") @db.VarChar(100)
  tokenHash String   @map("token_hash") @db.VarChar(255)
  family    String   @db.VarChar(100)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @db.VarChar(100)
  userId       String?  @map("user_id") @db.VarChar(100)
  userEmail    String?  @map("user_email") @db.VarChar(255)
  userRole     String?  @map("user_role") @db.VarChar(50)
  action       String   @db.VarChar(100)
  module       String?  @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  entityType   String?  @map("entity_type") @db.VarChar(100)
  entityId     String?  @map("entity_id") @db.VarChar(100)
  status       String?  @db.VarChar(50)
  details      Json?
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// 2. CUSTOMER & EMPLOYEE PROFILE MODELS
// ============================================================================

model CustomerProfile {
  id                     String       @id @db.VarChar(100)
  userId                 String       @unique @map("user_id") @db.VarChar(100)
  customerCode           String?      @unique @map("customer_code") @db.VarChar(100)
  labName                String       @map("lab_name") @db.VarChar(255)
  legalName              String?      @map("legal_name") @db.VarChar(255)
  customerType           CustomerType @default(CLINICAL_LABORATORY) @map("customer_type")
  gstNumber              String?      @map("gst_number") @db.VarChar(30)
  panNumber              String?      @map("pan_number") @db.VarChar(20)
  drugLicenseNumber      String?      @map("drug_license_number") @db.VarChar(100)
  contactPerson          String?      @map("contact_person") @db.VarChar(100)
  contactEmail           String?      @map("contact_email") @db.VarChar(255)
  contactPhone           String?      @map("contact_phone") @db.VarChar(30)
  addressLine1           String?      @map("address_line1") @db.VarChar(255)
  addressLine2           String?      @map("address_line2") @db.VarChar(255)
  city                   String?      @db.VarChar(100)
  state                  String?      @db.VarChar(100)
  pincode                String?      @db.VarChar(20)
  creditLimit            Decimal      @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  creditPeriodDays       Int          @default(30) @map("credit_period_days")
  currentOutstanding     Decimal      @default(0.00) @map("current_outstanding") @db.Decimal(12, 2)
  isApproved             Boolean      @default(true) @map("is_approved")
  assignedSalesPersonId  String?      @map("assigned_sales_person_id") @db.VarChar(100)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerCode])
  @@index([labName])
  @@map("customer_profiles")
}

model EmployeeProfile {
  id                 String     @id @db.VarChar(100)
  userId             String     @unique @map("user_id") @db.VarChar(100)
  employeeCode       String     @unique @map("employee_code") @db.VarChar(50)
  designation        String     @db.VarChar(100)
  department         Department @default(SERVICE)
  assignedTerritory  String     @default("NATIONAL") @map("assigned_territory") @db.VarChar(100)
  reportingManagerId String?    @map("reporting_manager_id") @db.VarChar(100)
  joiningDate        DateTime?  @map("joining_date")
  emergencyPhone     String?    @map("emergency_phone") @db.VarChar(30)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeCode])
  @@index([department])
  @@map("employee_profiles")
}

// ============================================================================
// 3. CATALOG & PRODUCT MASTER MODELS
// ============================================================================

model Company {
  id           String    @id @db.VarChar(100)
  code         String    @unique @db.VarChar(50)
  name         String    @db.VarChar(150)
  legalName    String?   @map("legal_name") @db.VarChar(255)
  logoUrl      String?   @map("logo_url") @db.VarChar(500)
  website      String?   @db.VarChar(255)
  country      String    @default("India") @db.VarChar(100)
  description  String?   @db.Text
  contactEmail String?   @map("contact_email") @db.VarChar(255)
  contactPhone String?   @map("contact_phone") @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  products     Product[]

  @@index([code])
  @@index([name])
  @@map("companies")
}

model Category {
  id          String     @id @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  description String?    @db.Text
  icon        String?    @db.VarChar(100)
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  parentId    String?    @map("parent_id") @db.VarChar(100)
  level       Int        @default(0)
  path        String?    @db.VarChar(255)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([code])
  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                         String              @id @db.VarChar(100)
  sku                        String              @unique @db.VarChar(100)
  catalogNumber              String?             @map("catalog_number") @db.VarChar(100)
  name                       String              @db.VarChar(255)
  shortDescription           String?             @map("short_description") @db.Text
  description                String?             @db.Text
  companyId                  String              @map("company_id") @db.VarChar(100)
  categoryId                 String              @map("category_id") @db.VarChar(100)
  productType                ProductType         @default(REAGENT) @map("product_type")
  hsnCode                    String              @map("hsn_code") @db.VarChar(20)
  gstRate                    Decimal             @default(12.00) @map("gst_rate") @db.Decimal(5, 2)
  basePrice                  Decimal             @map("base_price") @db.Decimal(12, 2)
  mrp                        Decimal             @map("mrp") @db.Decimal(12, 2)
  minOrderQuantity           Int                 @default(1) @map("min_order_quantity")
  isColdChain                Boolean             @default(false) @map("is_cold_chain")
  storageTemperature        String              @default("2°C to 8°C") @map("storage_temperature") @db.VarChar(100)
  shelfLifeMonths            Int?                @map("shelf_life_months")
  requiresPrescriptionOrAuth Boolean             @default(false) @map("requires_prescription_or_auth")
  isActive                   Boolean             @default(true) @map("is_active")
  isFeatured                 Boolean             @default(false) @map("is_featured")
  isDiscontinued             Boolean             @default(false) @map("is_discontinued")
  packSize                   String              @default("Standard Pack") @map("pack_size") @db.VarChar(100)
  stockQuantity              Int                 @default(0) @map("stock_quantity")
  stockStatus                StockStatus         @default(IN_STOCK) @map("stock_status")
  leadTimeDays               Int                 @default(2) @map("lead_time_days")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  company                    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category                   Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                     ProductImage[]
  documents                  ProductDocument[]
  packOptions                ProductPackOption[]

  @@index([sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([productType])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id           String   @id @db.VarChar(100)
  productId    String   @map("product_id") @db.VarChar(100)
  url          String   @db.VarChar(500)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  altText      String?  @map("alt_text") @db.VarChar(255)
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id            String   @id @db.VarChar(100)
  productId     String   @map("product_id") @db.VarChar(100)
  title         String   @db.VarChar(255)
  documentType  String   @map("document_type") @db.VarChar(50)
  fileUrl       String   @map("file_url") @db.VarChar(500)
  fileSizeBytes Int?     @map("file_size_bytes")
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  version       String?  @db.VarChar(50)
  isPublic      Boolean  @default(true) @map("is_public")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

model ProductPackOption {
  id                 String   @id @db.VarChar(100)
  productId          String   @map("product_id") @db.VarChar(100)
  packSizeName       String   @map("pack_size_name") @db.VarChar(150)
  packSku            String?  @map("pack_sku") @db.VarChar(100)
  testsCount         Int?     @map("tests_count")
  quantityMultiplier Decimal  @default(1.0) @map("quantity_multiplier") @db.Decimal(10, 2)
  price              Decimal  @db.Decimal(12, 2)
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_pack_options")
}

// ============================================================================
// 4. CUSTOMER EQUIPMENT & BIOMEDICAL SERVICE TICKETS
// ============================================================================

model CustomerEquipment {
  id                 String          @id @db.VarChar(100)
  customerId         String          @map("customer_id") @db.VarChar(100)
  customerLabName    String?         @map("customer_lab_name") @db.VarChar(255)
  customerCode       String?         @map("customer_code") @db.VarChar(100)
  productId          String?         @map("product_id") @db.VarChar(100)
  productSku         String?         @map("product_sku") @db.VarChar(100)
  equipmentName      String          @map("equipment_name") @db.VarChar(255)
  companyId          String?         @map("company_id") @db.VarChar(100)
  companyName        String?         @map("company_name") @db.VarChar(150)
  modelNumber        String          @map("model_number") @db.VarChar(100)
  serialNumber       String          @unique @map("serial_number") @db.VarChar(100)
  manufacturer       String?         @db.VarChar(100)
  department         String?         @db.VarChar(100)
  locationDepartment String?         @map("location_department") @db.VarChar(100)
  contactPerson      String?         @map("contact_person") @db.VarChar(100)
  contactPhone       String?         @map("contact_phone") @db.VarChar(30)
  installationDate   DateTime?       @map("installation_date")
  warrantyStatus     String?         @map("warranty_status") @db.VarChar(50)
  warrantyExpiryDate DateTime?       @map("warranty_expiry_date")
  lastServiceDate    DateTime?       @map("last_service_date")
  nextPmDueDate      DateTime?       @map("next_pm_due_date")
  status             String          @default("ACTIVE") @db.VarChar(50)
  healthScore        Int?            @map("health_score")
  qrCode             String?         @map("qr_code") @db.VarChar(255)
  imageUrl           String?         @map("image_url") @db.VarChar(500)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  customer           User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceTickets     ServiceTicket[]

  @@index([customerId])
  @@index([serialNumber])
  @@map("customer_equipments")
}

model ServiceSparePartCatalog {
  id          String               @id @db.VarChar(100)
  partNumber  String               @unique @map("part_number") @db.VarChar(100)
  partName    String               @map("part_name") @db.VarChar(255)
  costPrice   Decimal              @map("cost_price") @db.Decimal(12, 2)
  salePrice   Decimal              @map("sale_price") @db.Decimal(12, 2)
  stockQty    Int                  @default(0) @map("stock_qty")
  criticality SparePartCriticality @default(STANDARD)
  stockStatus SparePartStockStatus @default(IN_STOCK) @map("stock_status")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  partsUsed   ServiceTicketPartUsed[]

  @@map("service_spare_parts_catalog")
}

model ServiceTicket {
  id                   String           @id @db.VarChar(100)
  ticketNumber         String           @unique @map("ticket_number") @db.VarChar(50)
  customerId           String           @map("customer_id") @db.VarChar(100)
  category             String           @db.VarChar(50)
  equipmentId          String?          @map("equipment_id") @db.VarChar(100)
  priority             TicketPriority   @default(HIGH)
  title                String           @db.VarChar(255)
  description          String           @db.Text
  errorCode            String?          @map("error_code") @db.VarChar(100)
  status               TicketStatus     @default(NEW)
  assignedEngineerId   String?          @map("assigned_engineer_id") @db.VarChar(100)
  assignedAt           DateTime?        @map("assigned_at")
  acknowledgedAt       DateTime?        @map("acknowledged_at")
  scheduledVisitDate   DateTime?        @map("scheduled_visit_date")
  scheduledVisitSlot   String?          @map("scheduled_visit_slot") @db.VarChar(50)
  engineerOnTheWayAt   DateTime?        @map("engineer_on_the_way_at")
  slaTargetHours       Int              @default(8) @map("sla_target_hours")
  slaTargetTimestamp   DateTime         @map("sla_target_timestamp")
  slaStatus            String           @default("ON_TRACK") @map("sla_status") @db.VarChar(50)
  resolvedAt           DateTime?        @map("resolved_at")
  closedAt             DateTime?        @map("closed_at")
  reopenedAt           DateTime?        @map("reopened_at")
  reopenedById         String?          @map("reopened_by_id") @db.VarChar(100)
  reopenReason         String?          @map("reopen_reason") @db.Text
  notes                Json?
  attachments          Json?
  partsUsedPayload     Json?            @map("parts_used_payload")
  customerCommPayload  Json?            @map("customer_comm_payload")
  disputeHistory       Json?            @map("dispute_history")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

