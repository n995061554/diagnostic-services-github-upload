# ============================================================================
# DIAGNOSTIC SERVICES — ENVIRONMENT SPECIFICATION & DEPLOYMENT CONFIGURATION
# Copy this file to .env before starting the server in development or production.
# NEVER commit production credentials or live secrets into version control.
# ============================================================================

# Runtime Environment
NODE_ENV=production
PORT=3000

# CORS Security Allowlist
# Comma-separated list of fully-qualified origins permitted to access APIs in production
# Example: https://app.diagnosticservices.com,https://admin.diagnosticservices.com
CORS_ALLOWED_ORIGINS=https://app.diagnosticservices.com,https://admin.diagnosticservices.com

# Core AI Service
# Required for Gemini AI API calls (automated report insights and recommendations)
GEMINI_API_KEY=

# Public Base URL
# The canonical URL where this application or API service is hosted
APP_URL=https://app.diagnosticservices.com

# JWT Authentication Secrets (Must be at least 32-64 characters of high-entropy randomness in production)
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_ACCESS_SECRET_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_HIGH_ENTROPY_REFRESH_SECRET_64_CHARS
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP & Verification Safety Guard
# Set to "false" in staging and production to disallow simulated/mock OTPs
# Set to "true" ONLY in local unit/integration tests without SMS gateways
ALLOW_SIMULATED_OTP=false

# ============================================================================
# PERSISTENCE & POSTGRESQL CONFIGURATION
# ============================================================================
# Database Connection (PostgreSQL 14+ / Supabase / AWS RDS / Google Cloud SQL)
# Standard format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
# When DATABASE_URL is set, Prisma Client connects directly to PostgreSQL.
# In local development or during transient network disconnects, persistent disk store
# (server/persistence/stateStore.json) guarantees durability without data loss.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STAGING_PASSWORD@localhost:5432/diagnostic_services?schema=public

# Database Startup Guard (PRISMA_STRICT_MODE)
# Set to "true" in production to halt server immediately (process.exit(1)) if PostgreSQL is unreachable at startup.
# Set to "false" in development to permit fallback to durable local JSON store.
PRISMA_STRICT_MODE=true

# Payment Gateway Secrets (Server-side only)
PAYMENT_PROVIDER_SECRET=REPLACE_WITH_RAZORPAY_OR_STRIPE_SECRET
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PAYMENT_WEBHOOK_SIGNING_SECRET

# Notification and Cloud Storage Service Secrets (Server-side only)
NOTIFICATION_SERVICE_SECRET=REPLACE_WITH_SMS_PUSH_NOTIFICATION_KEY
STORAGE_SERVICE_SECRET=REPLACE_WITH_S3_OR_GCS_BUCKET_KEY
